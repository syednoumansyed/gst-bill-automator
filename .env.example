# Copy to .env.local (local dev) or pass to Docker. Every variable is optional.

# Airtable personal access token (scopes: data.records:read/write, schema.bases:read/write)
AIRTABLE_API_KEY=
# Airtable base ID to sync invoices into (starts with "app")
AIRTABLE_BASE_ID=
# Airtable table name (default: GST Invoices)
AIRTABLE_TABLE_NAME=
# Vercel Blob read/write token, used for Airtable PDF attachments
# Uploads PDFs as PUBLIC Vercel Blob URLs for Airtable attachments; leave empty to sync without attachments
BLOB_READ_WRITE_TOKEN=
# Password protecting /settings and the config API (set this if the app is reachable by others)
ADMIN_PASSWORD=
# Business profile as a JSON string; used instead of config/business.json on read-only hosts
BUSINESS_CONFIG_JSON=
# Set to 1 for hosted share mode: no login, settings off, nothing synced
# WARNING: share mode lets anyone with the link generate invoices carrying your GSTIN, PAN and bank details
SHARE_MODE=
# Set to 1 together with SHARE_MODE so the browser UI knows about share mode
NEXT_PUBLIC_SHARE_MODE=
# Path to a Chromium/Chrome binary for PDF rendering (set automatically in Docker)
PUPPETEER_EXECUTABLE_PATH=
# Host port the Docker container is published on (default: 3002)
GST_PORT=
